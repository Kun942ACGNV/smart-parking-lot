{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "智慧停車場 CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "parking",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "智慧停車場 CLI（保存狀態）",
      "type": "debugpy",
      "request": "launch",
      "module": "parking",
      "args": ["--state", "parking_state.json"],
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
